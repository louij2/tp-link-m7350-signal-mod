#! /bin/sh
# LTE signal-stats poller for the TP-Link M7350 web-UI mod.
# Makes the modem AT channel world-writable, then starts the polling daemon
# that caches signal metrics to /tmp/signal.json for the CGI endpoint.
# Installed as /etc/init.d/signal_poll, linked from /etc/rc5.d/S98signal_poll.
#
# NOTE: this device's busybox 1.18.5 start-stop-daemon is unusable for a shell
# daemon here -- with "-x /usr/bin/signal_poll.sh" it self-matches its own argv
# and skips the start. We launch with setsid (new session, survives the adb
# shell / init disconnect) and find the PID by scanning /proc, excluding self.

DAEMON=/usr/bin/signal_poll.sh
SMD=/dev/smd7

# Print PIDs of running daemon instances (one per line), never our own shell.
sig_pids() {
  me=$$
  for d in /proc/[0-9]*; do
    p=${d##*/}
    [ "$p" = "$me" ] && continue
    grep -qs "$DAEMON" "$d/cmdline" 2>/dev/null && echo "$p"
  done
}

case "$1" in
  start)
    echo -n "Starting signal_poll: "
    [ -e "$SMD" ] && chmod 666 "$SMD"
    if [ -n "$(sig_pids)" ]; then
      echo "already running"
      exit 0
    fi
    # setsid detaches into its own session; nohup ignores SIGHUP so the daemon
    # also survives a manual "adb shell" launch (adbd SIGHUPs descendants on
    # disconnect). The daemon redirects its own stdio, so nothing blocks here.
    nohup setsid "$DAEMON" </dev/null >/dev/null 2>&1 &
    # Re-apply the web-UI "TTL-fix" rule at boot if it was left enabled
    # (control.sh drops the marker). Keeps tethering-TTL normalisation sticky.
    if [ -f /etc/signalmod_ttl ]; then
      WAN=$(ip route 2>/dev/null | awk '/^default/{print $5; exit}')
      [ -z "$WAN" ] && WAN=rmnet0
      iptables -t mangle -C POSTROUTING -o "$WAN" -j TTL --ttl-set 65 2>/dev/null \
        || iptables -t mangle -A POSTROUTING -o "$WAN" -j TTL --ttl-set 65 2>/dev/null
    fi
    # Re-start the LAN-only FTP file server if the user left it enabled from the
    # web UI (marker set by control.sh). Serves / read-write on the LAN IP:21.
    LANIP=$(ip -4 addr show br0 2>/dev/null | grep -o 'inet [0-9.]*' | head -1 | cut -d' ' -f2)
    [ -z "$LANIP" ] && LANIP=192.168.0.1
    if [ -f /etc/signalmod_ftp ] && ! netstat -ltn 2>/dev/null | grep -q ':21 '; then
      nohup setsid tcpsvd -vE "$LANIP" 21 ftpd -w / </dev/null >/dev/null 2>&1 &
    fi
    # OLED brand rotator (alternates the OLED operator line model <-> ISP).
    if [ -x /usr/bin/oled_brand.sh ]; then
      for d in /proc/[0-9]*; do grep -qs oled_brand "$d/cmdline" 2>/dev/null && oledrun=1; done
      [ -z "$oledrun" ] && nohup setsid /usr/bin/oled_brand.sh </dev/null >/dev/null 2>&1 &
    fi
    echo "done"
    ;;
  stop)
    echo -n "Stopping signal_poll: "
    p=$(sig_pids)
    [ -n "$p" ] && kill $p 2>/dev/null
    echo "done"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    p=$(sig_pids)
    if [ -n "$p" ]; then
      echo "signal_poll running (pid $p)"
    else
      echo "signal_poll not running"
      exit 1
    fi
    ;;
  *)
    echo "Usage: signal_poll { start | stop | restart | status }" >&2
    exit 1
    ;;
esac

exit 0
